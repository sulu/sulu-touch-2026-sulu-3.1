<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>news</key>
    <group>news</group>

    <view>templates/articles/article</view>
    <controller>Sulu\Content\UserInterface\Controller\Website\ContentController::indexAction</controller>
    <cacheLifetime>604800</cacheLifetime>

    <meta>
        <title lang="en">News</title>
        <title lang="de">News</title>
    </meta>

    <properties>
        <property name="title" type="text_line" mandatory="true">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
            <params>
                <param name="headline" value="true"/>
            </params>

            <tag name="sulu.rlp.part"/>
        </property>

        <property name="url" type="page_tree_route">
            <meta>
                <title lang="en">Resourcelocator</title>
                <title lang="de">Adresse</title>
            </meta>
        </property>

        <property name="lead" type="text_area">
            <meta>
                <title lang="en">Lead</title>
                <title lang="de">Lead</title>
            </meta>
        </property>

        <property name="headerImage" type="single_media_selection">
            <meta>
                <title lang="en">Header image</title>
                <title lang="de">Headerbild</title>
            </meta>

            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="intro" type="text_editor">
            <meta>
                <title lang="en">Intro</title>
                <title lang="de">Einleitung</title>
            </meta>
        </property>

        <block name="sections" default-type="section" minOccurs="0">
            <meta>
                <title lang="en">Sections</title>
                <title lang="de">Sektionen</title>
            </meta>

            <params>
                <param name="add_button_text">
                    <meta>
                        <title lang="en">Add section</title>
                        <title lang="de">Sektion hinzufügen</title>
                    </meta>
                </param>
            </params>

            <types>
                <type name="section">
                    <meta>
                        <title lang="en">Section</title>
                        <title lang="de">Sektion</title>
                    </meta>

                    <properties>
                        <property name="headline" type="text_line">
                            <meta>
                                <title lang="en">Headline</title>
                                <title lang="de">Überschrift</title>
                            </meta>
                        </property>

                        <block name="blocks" default-type="text_image" minOccurs="0">
                            <meta>
                                <title lang="en">Content</title>
                                <title lang="de">Inhalt</title>
                            </meta>

                            <params>
                                <param name="add_button_text">
                                    <meta>
                                        <title lang="en">Add block</title>
                                        <title lang="de">Block hinzufügen</title>
                                    </meta>
                                </param>
                            </params>

                            <types>
                                <type ref="text_image"/>
                                <type ref="downloads"/>
                                <type ref="quote"/>
                            </types>
                        </block>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</template>
